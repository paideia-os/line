# line -- paideia-as build manifest
#
# Wave: R63  Milestone: M1  Landing: v1.1-A (syscall-wire; retires M1-001 STUB)
# Doc:  design/roadmap/post-r60-daily-use-roadmap.md §R63 in the paideia-os
#       monorepo. Category C tier-1 per design/tooling/plan.md.
#
# Consumed by `paideia-as build`. Each line is a directive; blank lines
# and lines starting with `#` are ignored. The v1.1-A build produces one
# output at build-out/line (elaborated .pdx -> ELF-like Paideia binary)
# plus a caps-manifest copy at build-out/line.caps for the InitCap sidecar
# packaging step performed by the paideia-os bin_seeds embed loop at
# R63.M1-007.
#
# paideia-as v0.36+ is the required toolchain floor (mov_b narrow-load
# mnemonic + @align attribute on .bss slots + cmp reg,imm32 staging via
# r11 above 0x7FFFFFFF -- the paideia-as #1248 mitigation set frozen at
# the R50 signed-1.0 wave). Any bump of this floor at M2 or beyond is
# noted in the CHANGELOG at the version bump.

name        = line
version     = 1.1.0-A
kind        = tool
entry       = Main::_start
output      = build-out/line
caps_decl   = caps.decl

# --- Source list (order-insensitive; paideia-as resolves module deps
# from `module <Basename> = structure { ... }` headers). ---------------
#
# v1.1-A is single-file: main.pdx carries the whole _start, the .bss
# scratch buffer, and every rodata message. Modularisation into
# per-concern files (Argv, Buffer, Dispatch, ...) lands as later
# milestones split the body along the M1-002 / M1-003 / M1-005 seams
# described in design/roadmap/post-r60-daily-use-roadmap.md §R63.
sources:
  - src/main.pdx                  # M1-001 (v1.1-A): _start + real syscall wire

# --- Library dependencies ---------------------------------------------
# v1.1-A pulls in zero libraries -- the four syscalls (read/write/open/
# close) are inlined directly, matching the self-contained pattern used
# by src/user/cat.pdx / echo_client.pdx / true.pdx / child_hello.pdx in
# paideia-os. libpdx-argv and libpdx-audit fold in at M1-002 / M1-005
# once command parsing + audit begin.
deps: []

# --- Test list --------------------------------------------------------
# Empty at v1.1-A. tests/ populated at M2 (see roadmap §R63.M2 pending
# scope; the boot smoke boot_r63_line_roundtrip lives in the paideia-os
# repo, not here).
tests: []

# --- Paideia-as compliance flags --------------------------------------
compliance:
  - module-basename-pascal        # Module <BasenamePascalCase>; no dir prefix
  - no-test-mnemonic              # zero-check via cmp reg, 0
  - cmp-imm32-only                # cmp reg, imm <= 0x7FFFFFFF; else stage via r11
  - r11-scratch                   # r11 is not preserved across calls
  - byte-load-zero-then-mov_b     # xor rax, rax; mov_b rax, [ptr]
  - sysv-push-pop-parity          # rsp % 16 == 0 at every nested call
  - reserved-label-prefix         # every branch label prefixed `line_`
