// src/main.pdx -- line.M1-005 v1.4-A --
// R63.M1-005 (paideia-os/line#5): retires the M1-001 batch round-trip body
// and lands the interactive REPL loop that binds the M1-003 buffer and
// M1-004 file-I/O primitives to an ed-style command grammar
// `a i d c p w e q Q . , $`.
//
// -----------------------------------------------------------------------
// v1.4-A landing summary
// -----------------------------------------------------------------------
//
// * _start now runs an interactive REPL:
//     [prompt ':'] -> [read one line from fd 0] -> [parse] -> [dispatch]
//     -> [loop] -> [terminal `q` emits fingerprint + LineEditRecord@0.1
//                   and sys_exit(0); `Q` sys_exit(0) with no emit].
// * The v1.1-A batch open+read+write+close round-trip is retired; the
//   file surface is now driven exclusively by the `w <path>` and
//   `e <path>` commands routed through fileio.pdx (M1-004).
// * The v1.1-D fingerprint `line ok -- lines=<N>\n` and the v1.1-B
//   LineEditRecord@0.1 emission tail MOVE from the batch happy-path to
//   the `q` handler per STATUS.md M1-006 note ("will move to the `q`
//   handler at M1-005 without a wire-format change"). Wire format is
//   preserved verbatim; <N> now reads buffer_last_addr() at exit time
//   instead of counting '\n' bytes in a scratch buffer, so a session
//   whose only activity was `e foo` -> `q` reports the count of lines
//   that landed in the buffer (== `lines_in`).
// * `edit_count` in the LineEditRecord tracks the sum of successful
//   `a`/`i`/`c`/`d` operations (incremented at each buffer_insert_line /
//   buffer_delete_line success site inside the dispatch). `files_read`
//   and `files_written` are left at 0 at v1.4-A pending a per-command
//   counter wire that lands with M2-002 audit integration.
//
// -----------------------------------------------------------------------
// Known blocker (NOT introduced by this file; tracked separately)
// -----------------------------------------------------------------------
//
// line#12 (P0154 hotfix): src/buffer.pdx's 8 pub-fn declarations are
// missing the `capabilities: {},` field between `effects:` and
// `justification:`, and missing `@{}` on the outer signature. paideia-as
// v0.36+ emits `error[P0154]: expected @{ or { for capabilities field`
// per function AND exits 0, masking the failure from `bash tools/
// build.sh`. Until line#12 lands the field-insertion patch, this REPL
// will NOT link even though main.pdx itself parses cleanly (main.pdx
// declares `capabilities:` on every fn per the requirement -- the
// blocker sits entirely in buffer.pdx). Build failure is EXPECTED at
// this landing; fixing #12 unblocks the smoke round-trip.
//
// -----------------------------------------------------------------------
// Grammar supported at v1.4-A (subset of POSIX ed)
// -----------------------------------------------------------------------
//
// Address forms:
//   .            current line (buffer_cursor_get)
//   $            last line   (buffer_last_addr)
//   <N>          literal 1-based line number (decimal)
//   <A1>,<A2>    address range (comma-separated)
//   ,            shorthand for `1,$` when both sides omitted
//   <empty>      cmd's implicit default (usually cursor)
//
// Commands (parsed as one ASCII byte; argument after optional space):
//   q            emit fingerprint + LineEditRecord + sys_exit(0)
//   Q            sys_exit(0) with no emit (discard session)
//   w <path>     fileio_write_buffer(path) -- write entire buffer
//   e <path>     fileio_read_file(path)    -- append file into buffer
//   p            print addr1..addr2 (default addr1 = addr2 = cursor)
//   d            delete addr1..addr2 (default addr1 = addr2 = cursor)
//   a            append input mode after addr1 (default cursor); read
//                lines from fd 0 until a lone `.`, insert each
//   i            insert input mode before addr1 (default cursor); same
//                terminator convention as `a`
//   c            change addr1..addr2 (delete range, then input-mode
//                before original addr1)
//   <addr alone> move cursor to addr and print (bare `5` prints line 5)
//
// Unknown command byte, malformed address, or an error return from any
// buffer_*/fileio_* call causes the REPL to emit `?\n` to fd 1 and
// resume the prompt loop (never sys_exit'd from the middle of a session
// -- the LINE PARSE FAIL rodata declared at v1.1-D remains an anchor
// for a future strict-mode wire but is NOT emitted at v1.4-A). EOF on
// fd 0 (sys_read returns 0 with no bytes accumulated) is treated as an
// implicit `q` -- same fingerprint + record emission + exit(0) path.
//
// -----------------------------------------------------------------------
// Line-reader mechanism (per-byte sys_read; no libc)
// -----------------------------------------------------------------------
//
// paideia-os user tools have no libc at R63 (no puts_new / getline /
// stdio). `main_read_line` reads one byte at a time from fd 0 via
// inline `sys_read(0, &line_buf[i], 1)` (SC+ ID 0), accumulating in
// line_buf until either (a) a '\n' byte is seen (excluded from the
// returned length) or (b) 4095 bytes are read (line_buf is 4096 bytes,
// last slot reserved for a NUL terminator that `w`/`e` argument
// handling writes in-place). Every syscall issued by this reader is
// governed by the same @{fs} cap that the batch path used.
//
// Per-byte reads are simple and correct for the interactive shell (one
// syscall per keystroke on a tty is what shells like bash do at the
// read-a-command layer); once R64+ grows a buffered stdio, this reader
// can be replaced with a chunked variant. For non-interactive input
// (heredoc piped into `line`), the per-byte cost is negligible.
//
// -----------------------------------------------------------------------
// `q` vs `Q` semantics
// -----------------------------------------------------------------------
//
// `q` (soft quit): emits the R63.M1-006 fingerprint `line ok -- lines=
// <N>\n` to fd 1 (three sys_writes: prefix + variable decimal via
// line_print_u64_dec + newline) AND the LineEditRecord@0.1 semantic-
// pipe record (v1.1-B format, unchanged wire) BEFORE sys_exit(0).
// Consumers (shell smoke, downstream analytics) see both signals.
//
// `Q` (hard quit): sys_exit(0) immediately with NO fingerprint and NO
// record. Matches POSIX ed's "unconditional quit, discard unsaved
// changes" convention. At v1.4-A we do not track a dirty flag (no
// modification-since-last-write bit); the `Q` distinction is therefore
// primarily semantic-pipe-signal-suppression: a session ended with `Q`
// tells downstream analytics that the operator explicitly discarded,
// even though the buffer contents were not persisted to disk. Add a
// dirty flag at M2 alongside the audit integration to enforce the
// classic "cannot `q` a dirty buffer without `w` first, but `Q` works"
// ed policy.
//
// -----------------------------------------------------------------------
// Error-shape reporting (`?` posture)
// -----------------------------------------------------------------------
//
// Every buffer_* and fileio_* return is compared against the
// `top-bit-set` sentinel band before use (`cmp rax, 512; ja` for
// buffer.pdx's [1,512] valid range; `cmp rax, 0; jne` for fileio.pdx's
// {0=OK} return). A sentinel triggers a single sys_write(1, "?\n", 2)
// and jumps back to the prompt -- never sys_exit'd. This matches
// POSIX ed's "?" diagnostic for any error condition, and keeps the
// REPL alive so the operator can retry with a valid command. The
// specific sentinel value (BUFFER_ERR_OOB / POOL_FULL / LINE_TOO_LONG /
// LINE_ERR_OPEN_FAIL / WRITE_FAIL / READ_FAIL) is NOT surfaced at
// v1.4-A; future work at M2 can extend the "?" to a per-cause message
// when audit + verbose modes land. Unknown-command and malformed-
// address paths use the SAME "?\n" wire, so the operator sees one
// consistent error shape across all failure modes.
//
// -----------------------------------------------------------------------
// SC+ ID discipline (same as v1.1-D; sysno 115 for semantic pipe)
// -----------------------------------------------------------------------
//
//   0   = sys_read(fd, buf, count)     -> count read, 0 on EOF, or -errno
//   1   = sys_write(fd, buf, count)    -> count written or -errno
//   2   = sys_open(path, flags, mode)  -> fd or -errno    (in fileio.pdx)
//   3   = sys_close(fd)                -> 0 or -errno     (in fileio.pdx)
//   60  = sys_exit(status)             -> never returns
//   115 = sys_semantic_send(schema, record_ptr, record_len)  (q handler)
//                                      -> 0 or -errno
//
// This file issues sysnos 0, 1, 60, 115 directly; sysnos 2 and 3 arrive
// through the fileio.pdx cross-module calls at `w` and `e` dispatch.
//
// -----------------------------------------------------------------------
// Cross-module symbol dependencies (resolved by paideia-as name-lookup;
// no `use` header per the fileio.pdx / dispatch.pdx precedent)
// -----------------------------------------------------------------------
//
//   Buffer:  buffer_last_addr, buffer_cursor_get, buffer_cursor_set,
//            buffer_get_line_ptr, buffer_get_line_len,
//            buffer_insert_line, buffer_delete_line
//   Fileio:  fileio_write_buffer, fileio_read_file
//
// Local helpers:
//   line_print_u64_dec        u64 -> decimal ASCII via fd 1 (unchanged
//                             from v1.1-D; used by the `q` fingerprint)
//   main_read_line            per-byte fd-0 line reader (returns len,
//                             or 0xFFFFFFFFFFFFFF20 EOF sentinel)
//   main_parse_line           address + command tokenizer, writes to
//                             .bss slots (main_addr1/2, main_cmd, ...)
//   main_input_mode           input-mode loop for `a`/`i`/`c` (reads
//                             lines until lone `.` and inserts each)
//   main_print_addr           print one line at `addr` with '\n' tail
//
// -----------------------------------------------------------------------
// Encoder guardrails (paideia-as v0.36+; same as v1.1-D)
// -----------------------------------------------------------------------
//
// * Reserved-label discipline: `main_`, `mrl_` (main_read_line), `mpl_`
//   (main_parse_line), `mim_` (main_input_mode), `mpa_` (main_print_addr),
//   `line_pud_` (line_print_u64_dec), `repl_` (dispatch inside _start).
//   Avoids `loop`/`if`/`else`/`for`/`while`/`match`/`return` keyword
//   collisions.
// * No `test reg, reg` -- every zero-check is `cmp reg, 0`.
// * No `and reg, imm64` -- no wide masks.
// * No 2-op `imul r, imm` -- decimal parse multiplies by 10 via
//   `mov rbx, rcx; shl rcx, 3; shl rbx, 1; add rcx, rbx` (10x = 8x + 2x).
// * No scaled-index `[reg + N*idx]`; every address composed as
//   `lea rN, [rip + sym]; add rN, offset`.
// * Byte-load `xor rax, rax; mov_b rax, [rN]`; byte-store `mov [rN], al`.
// * `mov r64, imm32` for small immediates (all cmd bytes / lengths /
//   pool bounds fit); `mov r64, imm64` movabs only for the two sentinels
//   (0xFFFFFFFFFFFFFF20 = MAIN_ERR_EOF, 0xFFFFFFFFFFFFFF21 = MAIN_ERR_
//   PARSE) and the LineEdit schema tag (0x656E694C69644500).
// * Every `pub let ... : sig = fn ...` includes `capabilities: {...}`
//   (or `capabilities: {}` for pure functions) per the P0154 requirement
//   -- avoids the line#12 hotfix pattern in this file.
// * SysV callee-save discipline: helpers that make nested `call`s push
//   an ODD number of callee-save regs at entry (rsp entered with %16
//   == 8 from the caller's CALL; N pushes -> 8+8N; N odd -> %16 == 0
//   at every nested call site). `_start` is @no_frame with zero pushes
//   because it enters at rsp %16 == 0 per the PVH loader contract and
//   never returns to a caller.
// * Unsafe-bodied lambdas: MAX 6 params (B1708). All entries here take
//   0, 1, or 2 params.
// * Module basename `Main` matches filename `main.pdx` (PascalCase, no
//   directory prefix) per module-basename-pascal.
//
// -----------------------------------------------------------------------
// Effects / capabilities
// -----------------------------------------------------------------------
//
// _start declares {mem, sysreg} @{fs, sched} (same shape as v1.1-D).
// {mem} covers rodata + .bss access; {sysreg} covers every SYSCALL
// clobber; @{fs} covers sys_read (SC+ ID 0) on fd 0, sys_write on fds
// 1/2 (SC+ ID 1), and the fileio.pdx @{fs} chain reached via `w`/`e`
// dispatch; @{sched} covers sys_exit(0) on the `q`/`Q`/EOF paths.
// sys_semantic_send (SC+ ID 115) at the `q` tail takes NO cap slot per
// R107-M0-001 (schema opaque; producer capability-ungated).

module Main = structure {

  // --------------------------------------------------------------------
  // Sizing constants (documentation anchors; numeric literals used
  // directly in code for encoder cleanness).
  // --------------------------------------------------------------------
  pub let main_line_cap              : u64 = 4095   // last slot is NUL
  pub let main_line_buf_bytes        : u64 = 4096

  // --------------------------------------------------------------------
  // Main-local error sentinels (disjoint from buffer.pdx 0x01..0x03 and
  // fileio.pdx 0x11..0x13 sub-bands; main uses 0x20..0x2F).
  //   MAIN_ERR_EOF   = 0xFFFFFFFFFFFFFF20  -- fd 0 EOF with zero bytes
  //   MAIN_ERR_PARSE = 0xFFFFFFFFFFFFFF21  -- reserved for a future
  //                    strict-mode dispatch; not surfaced at v1.4-A
  //                    (the REPL always continues on parse err rather
  //                    than exiting with LINE PARSE FAIL).
  // --------------------------------------------------------------------
  pub let main_err_eof               : u64 = 0xFFFFFFFFFFFFFF20
  pub let main_err_parse             : u64 = 0xFFFFFFFFFFFFFF21

  // --------------------------------------------------------------------
  // Rodata: prompt, diagnostics, fingerprint pieces, schema tag.
  //
  // The v1.1-A batch-mode diagnostic strings (line_usage_msg,
  // line_read_fail_open_msg, line_read_fail_read_msg, line_write_fail_
  // open_msg, line_write_fail_write_msg) are RETIRED at v1.4-A -- the
  // REPL never sys_exit's mid-session and the batch path they served is
  // gone. line_parse_fail_msg is preserved as declared anchor per the
  // R63.M1-006 exit-status inventory (reserved for a future strict-mode
  // dispatch that sys_exit(5)s on unrecoverable parse err).
  // --------------------------------------------------------------------
  pub let main_prompt_msg            : [u8; 2]  = ":\0"
  pub let main_prompt_msg_len        : u64      = 1

  pub let main_qmark_nl_msg          : [u8; 3]  = "?\n\0"
  pub let main_qmark_nl_msg_len      : u64      = 2

  pub let main_nl_msg                : [u8; 2]  = "\n\0"
  pub let main_nl_msg_len            : u64      = 1

  pub let line_ok_prefix_msg         : [u8; 18] = "line ok -- lines=\0"
  pub let line_ok_prefix_msg_len     : u64      = 17

  pub let line_parse_fail_msg        : [u8; 17] = "LINE PARSE FAIL\n\0"
  pub let line_parse_fail_msg_len    : u64      = 16

  // 8-byte ASCII schema tag `LineEdit` (LE), loaded via imm64 movabs
  // at the sys_semantic_send call site (matches pdxsock_schema_sock_
  // session at pdxsock/src/main.pdx line 820). rodata anchor for the
  // ver-01 semantic; a schema bump to @0.2 increments both this
  // declaration and the movabs.
  pub let line_schema_tag            : u64      = 0x656E694C69644500

  // --------------------------------------------------------------------
  // .bss scratch pools and parser state.
  //
  // line_buf: 4 KiB reader + argument-holder. main_read_line writes up
  // to 4095 bytes here; the last slot is reserved so `w`/`e` handlers
  // can write a NUL byte at [arg_ofs + arg_len] in place before passing
  // the buffer pointer to fileio_{write,read}_*. Reused as input-mode
  // scratch during `a`/`i`/`c` (each read overwrites; the previously
  // parsed command was already dispatched to before the read).
  //
  // Parser output slots. main_parse_line writes here; dispatch reads
  // here. Deliberately in .bss (not registers) so parse can freely
  // clobber caller-save across the two buffer_cursor_get / buffer_
  // last_addr calls it makes.
  //
  // main_edit_count: cumulative count of successful buffer_insert_line
  // + buffer_delete_line events for the session. Carried into the
  // LineEditRecord's `edit_count` field at `q` emit.
  //
  // line_record_buf / line_session_start_ns: unchanged from v1.1-B.
  // --------------------------------------------------------------------
  pub let mut line_buf               : [u8; 4096] = uninit @align(8)
  pub let mut main_line_len          : u64        = 0
  pub let mut main_pos               : u64        = 0
  pub let mut main_addr1             : u64        = 0
  pub let mut main_addr2             : u64        = 0
  pub let mut main_addr1_set         : u64        = 0
  pub let mut main_addr2_set         : u64        = 0
  pub let mut main_cmd               : u64        = 0
  pub let mut main_arg_ofs           : u64        = 0
  pub let mut main_arg_len           : u64        = 0
  pub let mut main_edit_count        : u64        = 0
  pub let mut main_temp_ptr          : u64        = 0

  pub let mut line_record_buf        : [u8; 56]   = uninit @align(8)
  pub let mut line_session_start_ns  : u64        = 0

  // ====================================================================
  // line_print_u64_dec(value: u64) -> ()
  //
  // Unchanged from v1.1-D. u64 -> decimal ASCII via sys_write to fd 1.
  // See v1.1-D §"line_print_u64_dec" for the full justification; the
  // function body is verbatim from the previous landing.
  // ====================================================================
  pub let line_print_u64_dec : (u64) -> () !{mem, sysreg} @{fs} =
    fn (value: u64) -> unsafe {
      effects: {mem, sysreg},
      capabilities: {fs},
      justification: "R63.M1-006 v1.1-D (unchanged at v1.4-A): u64 -> decimal ASCII for the `line ok -- lines=<N>\\n` fingerprint suffix, emitted via sys_write (SC+ ID 1) to fd 1. Verbatim divide-by-10 loop shape (src/user/dmesg.pdx §dm_print_u64_dec / src/user/cp.pdx §cp_print_u64_dec). Zero fast-path emits a single '0' digit and returns. Otherwise r9 holds the remaining value and r10 is a right-to-left cursor into a 24-byte stack scratch starting at offset 19; each iteration divides r9 by 10 via `xor rdx,rdx; div rcx`, converts the remainder to ASCII, stores it at the cursor, decrements the cursor, and loops until the quotient is zero. Final cursor position plus (rsp+20 - cursor) gives the [buf, len] slice, emitted as sys_write(fd=1, buf, len). @no_frame with self-managed 24-byte stack scratch (`sub rsp, 24` at entry keeps rsp %16 aligned given the caller's CALL pushed 8 bytes on top of a %16==0 rsp). Encoder-gap discipline: register-only cursor arithmetic; every zero-check `cmp reg, 0` (no `test`); byte-store `mov [r10], dl` (r/m8, r8 form). Reserved-label discipline: internal labels prefixed `line_pud_`.",
      block: {
        sub rsp, 24;

        cmp rdi, 0;
        jne line_pud_divide_setup;
          mov al, 0x30;
          mov [rsp], al;
          mov rdi, 1;
          mov rsi, rsp;
          mov rdx, 1;
          mov rax, 1;
          syscall;
          add rsp, 24;
          ret;

        line_pud_divide_setup:
          mov r9, rdi;
          mov r10, rsp;
          add r10, 19;

        line_pud_loop_top:
          mov rax, r9;
          mov rcx, 10;
          xor rdx, rdx;
          div rcx;
          add rdx, 0x30;
          mov [r10], dl;
          mov r9, rax;
          cmp r9, 0;
          je line_pud_loop_done;
          sub r10, 1;
          jmp line_pud_loop_top;

        line_pud_loop_done:
          mov rax, rsp;
          add rax, 20;
          sub rax, r10;
          mov rdx, rax;
          mov rsi, r10;
          mov rdi, 1;
          mov rax, 1;
          syscall;
          add rsp, 24;
          ret
      }
    } @no_frame

  // ====================================================================
  // main_read_line() -> u64
  //
  // Per-byte fd-0 line reader. Reads bytes into line_buf[] until '\n'
  // (excluded from returned length), EOF, or the 4095-byte cap. Stores
  // the byte count in main_line_len and returns it. On EOF with zero
  // bytes accumulated returns MAIN_ERR_EOF (0xFFFFFFFFFFFFFF20). Errors
  // (sys_read < 0) are also mapped to MAIN_ERR_EOF -- the REPL treats
  // any fd-0 failure as "end of session" and quits cleanly.
  //
  // Register plan:
  //   r8  = byte counter (0..4095)
  //   r9  = scratch (byte-load destination pointer)
  //   rax/rdi/rsi/rdx = sys_read argument shuffle
  //   No callee-save touched; no `call` issued (only SYSCALL).
  // ====================================================================
  pub let main_read_line : () -> u64 !{mem, sysreg} @{fs} =
    fn () -> unsafe {
      effects: {mem, sysreg},
      capabilities: {fs},
      justification: "R63.M1-005 v1.4-A: per-byte reader over sys_read(0, &line_buf[r8], 1). Accumulator r8 starts at 0; each iteration issues one sys_read (SC+ ID 0), signed-negative-checks rax (`cmp rax, 0; jl` for -errno; `cmp rax, 0; je` for EOF), then narrow-loads the just-read byte via `xor rax, rax; mov_b rax, [r9]` and branches on '\\n' (0x0A). Non-newline: increment r8 and loop. Newline: increment r8, then subtract 1 to exclude '\\n' from the returned length; store to main_line_len; return len in rax. EOF branch: if r8 > 0 (partial line seen before EOF), treat as a complete line -- store r8, return r8. Otherwise return MAIN_ERR_EOF (0xFFFFFFFFFFFFFF20 via movabs). Cap at 4095 (r8 >= 4095 -> return r8 as a truncated line; the last slot at index 4095 is reserved for the `w`/`e` NUL terminator). @no_frame; no call, no push -- sys_read is amd64 fast-syscall (clobbers only rax/rcx/r11) so r8 survives every iteration without saving. Encoder discipline: `cmp reg, 0` for every zero-check; no `test`; byte-load narrow-idiom; 4095 fits imm32 as unsigned. Reserved-label prefix `mrl_`.",
      block: {
        xor r8, r8;                         // byte counter

      mrl_top:
        // Cap: leave slot [4095] reserved for the `w`/`e` NUL byte.
        mov rax, 4095;
        cmp r8, rax;
        jae mrl_full;

        // sys_read(0, &line_buf + r8, 1).
        xor rdi, rdi;                       // fd = stdin
        lea rsi, [rip + line_buf];
        add rsi, r8;
        mov rdx, 1;
        xor rax, rax;                       // SC+ ID 0 = sys_read
        syscall;

        cmp rax, 0;
        jl  mrl_error;
        je  mrl_eof;

        // Byte-load the just-read byte to check for '\n'.
        lea r9, [rip + line_buf];
        add r9, r8;
        xor rax, rax;
        mov_b rax, [r9];
        add r8, 1;                          // count this byte
        cmp rax, 10;                        // ASCII '\n'
        je  mrl_hit_nl;
        jmp mrl_top;

      mrl_hit_nl:
        sub r8, 1;                          // exclude '\n' from length
        mov [rip + main_line_len], r8;
        mov rax, r8;
        ret;

      mrl_full:
        mov [rip + main_line_len], r8;
        mov rax, r8;
        ret;

      mrl_eof:
        cmp r8, 0;
        jne mrl_full;                       // partial line before EOF
        // Genuine EOF with nothing read: return sentinel.
        mov [rip + main_line_len], r8;      // == 0
        mov rax, 0xFFFFFFFFFFFFFF20;
        ret;

      mrl_error:
        // Map -errno to the same EOF sentinel: REPL will quit cleanly.
        xor rax, rax;
        mov [rip + main_line_len], rax;
        mov rax, 0xFFFFFFFFFFFFFF20;
        ret
      }
    } @no_frame

  // ====================================================================
  // main_parse_line() -> u64
  //
  // Tokenizes line_buf[0..main_line_len) into the parser output slots:
  //   main_pos          scan cursor (final position after parse)
  //   main_addr1_set    1 if addr1 was parsed, 0 otherwise
  //   main_addr1        resolved 1-based address (only if addr1_set)
  //   main_addr2_set    1 if addr2 was parsed, 0 otherwise
  //   main_addr2        resolved 1-based address (only if addr2_set)
  //   main_cmd          command byte (0 if line ended before a cmd char)
  //   main_arg_ofs      byte offset of the argument's first char
  //   main_arg_len      length of the argument in bytes (0 if none)
  //
  // Address literals '.' and '$' are resolved eagerly via buffer_cursor_
  // get and buffer_last_addr; decimal literals are converted inline via
  // a *10 = (<<3) + (<<1) fold. A leading ',' with no preceding addr1
  // defaults addr1 to 1 (ed convention: ",X" == "1,X"). A trailing ','
  // with no addr2 defaults addr2 to buffer_last_addr().
  //
  // Return value is always 0 at v1.4-A. Unknown command bytes are
  // deferred to dispatch (which emits "?\n" and continues). A future
  // strict-mode entry can return MAIN_ERR_PARSE (0xFFFFFFFFFFFFFF21) to
  // trigger sys_exit(5) -- currently unwired.
  //
  // Register plan:
  //   rbx = alignment push (dummy; parse makes calls to buffer_cursor_
  //         get / buffer_last_addr so entry rsp %16 == 8 needs +8 to
  //         reach %16 == 0)
  //   All working state kept in .bss slots (main_pos etc.) so calls
  //   freely clobber caller-save (r8..r11, rax/rcx/rdx/rsi/rdi).
  //   rcx used only in the decimal-parse fold (short-lived, no calls
  //   during the digit loop).
  // ====================================================================
  pub let main_parse_line : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem},
      capabilities: {},
      justification: "R63.M1-005 v1.4-A: tokenizer for the ed grammar `<addr1>[,<addr2>]<cmd>[ <arg>]`. Every mutable state slot (main_pos / main_addr{1,2}[_set] / main_cmd / main_arg_ofs / main_arg_len) lives in .bss so parse can safely clobber caller-save around the two nested `call` sites (buffer_cursor_get for '.' and buffer_last_addr for '$'), reloading the scan cursor from main_pos after each. Decimal parse multiplies by 10 via `mov rbx, rcx; shl rcx, 3; shl rbx, 1; add rcx, rbx` (10x = 8x + 2x -- avoids the banned 2-op `imul r, imm`). Leading '.' resolves to buffer_cursor_get(), '$' to buffer_last_addr(); both are @no_frame + no-call so their entry rsp alignment does not matter; the dummy `push rbx` at parse entry keeps rsp %16 == 0 at their call sites per SysV amd64 defensively. Comma handling: with no addr1 before, addr1 = 1 (ed `,X` shorthand for `1,X`); with no addr2 after, addr2 = buffer_last_addr() (ed `X,` shorthand for `X,$`; bare `,` becomes `1,$`). Whitespace (0x20 ' ') skipped between addr / cmd / arg tokens. arg_ofs / arg_len span line_buf[pos..line_len) after the cmd byte. Return always 0 at v1.4-A; unknown-cmd handling deferred to dispatch (emits `?\\n` and continues). Encoder discipline: `cmp reg, 0` for every zero-check; no `test`; byte-load `xor rax,rax; mov_b rax,[rN]`; no scaled-index; no `and reg, imm64`; no `imul`; reserved-label prefix `mpl_`. Capabilities: {} because no syscall is issued directly in this body -- only the memory-effect buffer_* calls; the caller (_start) supplies @{fs, sched} for the surrounding REPL turn.",
      block: {
        push rbx;                           // align rsp %16 == 0 for calls

        // Initialise all parser output slots to 0.
        xor rax, rax;
        mov [rip + main_pos], rax;
        mov [rip + main_addr1], rax;
        mov [rip + main_addr2], rax;
        mov [rip + main_addr1_set], rax;
        mov [rip + main_addr2_set], rax;
        mov [rip + main_cmd], rax;
        mov [rip + main_arg_ofs], rax;
        mov [rip + main_arg_len], rax;

        // --------------------------------------------------------------
        // Skip leading spaces before addr1.
        // --------------------------------------------------------------
      mpl_skip_lead:
        mov r10, [rip + main_line_len];
        mov r11, [rip + main_pos];
        cmp r11, r10;
        jae mpl_no_cmd;
        lea r9, [rip + line_buf];
        add r9, r11;
        xor rax, rax;
        mov_b rax, [r9];
        cmp rax, 0x20;
        jne mpl_addr1_try;
        add r11, 1;
        mov [rip + main_pos], r11;
        jmp mpl_skip_lead;

        // --------------------------------------------------------------
        // Try to parse addr1: '.', '$', or a decimal literal.
        // --------------------------------------------------------------
      mpl_addr1_try:
        mov r11, [rip + main_pos];
        mov r10, [rip + main_line_len];
        cmp r11, r10;
        jae mpl_no_cmd;
        lea r9, [rip + line_buf];
        add r9, r11;
        xor rax, rax;
        mov_b rax, [r9];

        cmp rax, 0x2E;                      // '.'
        jne mpl_addr1_try_dollar;
        // addr1 = buffer_cursor_get()
        call buffer_cursor_get;
        mov [rip + main_addr1], rax;
        mov r11, [rip + main_pos];
        add r11, 1;
        mov [rip + main_pos], r11;
        mov rax, 1;
        mov [rip + main_addr1_set], rax;
        jmp mpl_comma_check;

      mpl_addr1_try_dollar:
        cmp rax, 0x24;                      // '$'
        jne mpl_addr1_try_digit;
        call buffer_last_addr;
        mov [rip + main_addr1], rax;
        mov r11, [rip + main_pos];
        add r11, 1;
        mov [rip + main_pos], r11;
        mov rax, 1;
        mov [rip + main_addr1_set], rax;
        jmp mpl_comma_check;

      mpl_addr1_try_digit:
        cmp rax, 0x30;                      // '0'
        jl  mpl_comma_check;
        cmp rax, 0x39;                      // '9'
        ja  mpl_comma_check;

        // Decimal parse fold: rcx = rcx * 10 + digit.
        xor rcx, rcx;
      mpl_addr1_digit_loop:
        mov r10, [rip + main_line_len];
        mov r11, [rip + main_pos];
        cmp r11, r10;
        jae mpl_addr1_digit_done;
        lea r9, [rip + line_buf];
        add r9, r11;
        xor rax, rax;
        mov_b rax, [r9];
        cmp rax, 0x30;
        jl  mpl_addr1_digit_done;
        cmp rax, 0x39;
        ja  mpl_addr1_digit_done;
        sub rax, 0x30;                      // digit value
        // rcx = rcx * 10 + rax  (via <<3 + <<1)
        mov rbx, rcx;
        shl rcx, 3;
        shl rbx, 1;
        add rcx, rbx;
        add rcx, rax;
        add r11, 1;
        mov [rip + main_pos], r11;
        jmp mpl_addr1_digit_loop;
      mpl_addr1_digit_done:
        mov [rip + main_addr1], rcx;
        mov rax, 1;
        mov [rip + main_addr1_set], rax;

        // --------------------------------------------------------------
        // Optional ',' -> parse addr2 (with defaults per ed grammar).
        // --------------------------------------------------------------
      mpl_comma_check:
        mov r10, [rip + main_line_len];
        mov r11, [rip + main_pos];
        cmp r11, r10;
        jae mpl_cmd_seek;
        lea r9, [rip + line_buf];
        add r9, r11;
        xor rax, rax;
        mov_b rax, [r9];
        cmp rax, 0x2C;                      // ','
        jne mpl_cmd_seek;

        // Consume the comma.
        add r11, 1;
        mov [rip + main_pos], r11;

        // If addr1 was not set, default to 1 (ed `,X` == `1,X`).
        mov rax, [rip + main_addr1_set];
        cmp rax, 0;
        jne mpl_addr2_try;
        mov rax, 1;
        mov [rip + main_addr1], rax;
        mov [rip + main_addr1_set], rax;    // 1 (truthy)

        // --------------------------------------------------------------
        // Parse addr2: '.', '$', decimal, or default to last_addr().
        // --------------------------------------------------------------
      mpl_addr2_try:
        mov r10, [rip + main_line_len];
        mov r11, [rip + main_pos];
        cmp r11, r10;
        jae mpl_addr2_default;
        lea r9, [rip + line_buf];
        add r9, r11;
        xor rax, rax;
        mov_b rax, [r9];

        cmp rax, 0x2E;                      // '.'
        jne mpl_addr2_try_dollar;
        call buffer_cursor_get;
        mov [rip + main_addr2], rax;
        mov r11, [rip + main_pos];
        add r11, 1;
        mov [rip + main_pos], r11;
        mov rax, 1;
        mov [rip + main_addr2_set], rax;
        jmp mpl_cmd_seek;

      mpl_addr2_try_dollar:
        cmp rax, 0x24;                      // '$'
        jne mpl_addr2_try_digit;
        call buffer_last_addr;
        mov [rip + main_addr2], rax;
        mov r11, [rip + main_pos];
        add r11, 1;
        mov [rip + main_pos], r11;
        mov rax, 1;
        mov [rip + main_addr2_set], rax;
        jmp mpl_cmd_seek;

      mpl_addr2_try_digit:
        cmp rax, 0x30;
        jl  mpl_addr2_default;
        cmp rax, 0x39;
        ja  mpl_addr2_default;

        xor rcx, rcx;
      mpl_addr2_digit_loop:
        mov r10, [rip + main_line_len];
        mov r11, [rip + main_pos];
        cmp r11, r10;
        jae mpl_addr2_digit_done;
        lea r9, [rip + line_buf];
        add r9, r11;
        xor rax, rax;
        mov_b rax, [r9];
        cmp rax, 0x30;
        jl  mpl_addr2_digit_done;
        cmp rax, 0x39;
        ja  mpl_addr2_digit_done;
        sub rax, 0x30;
        mov rbx, rcx;
        shl rcx, 3;
        shl rbx, 1;
        add rcx, rbx;
        add rcx, rax;
        add r11, 1;
        mov [rip + main_pos], r11;
        jmp mpl_addr2_digit_loop;
      mpl_addr2_digit_done:
        mov [rip + main_addr2], rcx;
        mov rax, 1;
        mov [rip + main_addr2_set], rax;
        jmp mpl_cmd_seek;

      mpl_addr2_default:
        // Trailing `,` with no explicit addr2: default to last_addr().
        call buffer_last_addr;
        mov [rip + main_addr2], rax;
        mov rax, 1;
        mov [rip + main_addr2_set], rax;

        // --------------------------------------------------------------
        // Skip spaces, then read one cmd byte.
        // --------------------------------------------------------------
      mpl_cmd_seek:
      mpl_cmd_skip:
        mov r10, [rip + main_line_len];
        mov r11, [rip + main_pos];
        cmp r11, r10;
        jae mpl_no_cmd;
        lea r9, [rip + line_buf];
        add r9, r11;
        xor rax, rax;
        mov_b rax, [r9];
        cmp rax, 0x20;
        jne mpl_cmd_take;
        add r11, 1;
        mov [rip + main_pos], r11;
        jmp mpl_cmd_skip;

      mpl_cmd_take:
        mov [rip + main_cmd], rax;
        mov r11, [rip + main_pos];
        add r11, 1;
        mov [rip + main_pos], r11;

        // --------------------------------------------------------------
        // Skip leading spaces before the argument; record arg_ofs and
        // arg_len for `w`/`e` dispatch.
        // --------------------------------------------------------------
      mpl_arg_skip:
        mov r10, [rip + main_line_len];
        mov r11, [rip + main_pos];
        cmp r11, r10;
        jae mpl_ok;                         // no arg
        lea r9, [rip + line_buf];
        add r9, r11;
        xor rax, rax;
        mov_b rax, [r9];
        cmp rax, 0x20;
        jne mpl_arg_capture;
        add r11, 1;
        mov [rip + main_pos], r11;
        jmp mpl_arg_skip;

      mpl_arg_capture:
        mov [rip + main_arg_ofs], r11;
        mov rax, r10;
        sub rax, r11;
        mov [rip + main_arg_len], rax;
        jmp mpl_ok;

      mpl_no_cmd:
        // Fall through with main_cmd == 0.

      mpl_ok:
        xor rax, rax;
        pop rbx;
        ret
      }
    } @no_frame

  // ====================================================================
  // main_input_mode(after: u64) -> u64
  //
  // Reads lines from fd 0 and inserts each into the Buffer via
  // buffer_insert_line(after_current, &line_buf, main_line_len). Loop
  // terminates on either (a) a line consisting of exactly "." (one
  // byte, ASCII 0x2E) -- the standard ed input-mode terminator -- or
  // (b) EOF on fd 0 (also treated as a clean end-of-input).
  //
  // Each successful insert advances after_current by 1 (so subsequent
  // inserts land in order) and increments main_edit_count.
  //
  // Returns 0 on clean termination; MAIN_ERR_PARSE (0xFFFFFFFFFFFFFF21)
  // on the first buffer_insert_line sentinel return, so the caller can
  // emit "?\n" once and resume the top-level prompt loop.
  //
  // Register plan:
  //   r12 = after_current (persists across sys_read + buffer_insert_line)
  //   rax/rdi/rsi/rdx = call argument shuffle
  //   Push r12 (1 push) at entry -> rsp %16 == 0 at every nested call.
  // ====================================================================
  pub let main_input_mode : (u64) -> u64 !{mem, sysreg} @{fs} =
    fn (after: u64) -> unsafe {
      effects: {mem, sysreg},
      capabilities: {fs},
      justification: "R63.M1-005 v1.4-A: input-mode loop for `a` / `i` / `c` dispatch. Reads lines via `call main_read_line` (which reuses line_buf as scratch); on EOF or a lone `.` line terminates the loop and returns 0. Each read line is inserted via `call buffer_insert_line(r12, &line_buf, main_line_len)`; r12 is the SysV callee-save cursor holding the next `after` addr, persistent across the calls and the sys_read syscalls both. Sentinel check `cmp rax, 512; ja` catches every buffer.pdx error (POOL_FULL / LINE_TOO_LONG / OOB all have bit 63 set, unsigned-dwarfs 512); on hit, return MAIN_ERR_PARSE and let the caller emit `?\\n` once. Each successful insert increments after_current (r12) and main_edit_count (.bss). Empty line (main_line_len == 0) is still inserted as an empty line -- ed convention allows blank lines inside input mode; only a lone `.` (len == 1 && line_buf[0] == 0x2E) terminates. Register/alignment discipline: single push r12 keeps rsp %16 == 0 at every nested call (entry rsp %16 == 8; 8 + 8 == 16). Encoder discipline identical to fileio.pdx: `cmp reg, 0` for zero-checks; byte-load narrow-idiom; no `test`; no `and reg, imm64`; no scaled-index. Reserved-label prefix `mim_`.",
      block: {
        push r12;
        mov r12, rdi;                       // r12 = after_current

      mim_loop:
        call main_read_line;
        // rax = len, or MAIN_ERR_EOF (0xFFFFFFFFFFFFFF20).
        mov r10, 0xFFFFFFFFFFFFFF20;
        cmp rax, r10;
        je  mim_done;

        // Lone "." terminates input mode (len == 1 && line_buf[0] == '.').
        mov r11, [rip + main_line_len];
        cmp r11, 1;
        jne mim_insert;
        lea r9, [rip + line_buf];
        xor rax, rax;
        mov_b rax, [r9];
        cmp rax, 0x2E;
        je  mim_done;

      mim_insert:
        mov rdi, r12;
        lea rsi, [rip + line_buf];
        mov rdx, [rip + main_line_len];
        call buffer_insert_line;
        cmp rax, 512;
        ja  mim_err;

        add r12, 1;                         // after_current++
        mov rax, [rip + main_edit_count];
        add rax, 1;
        mov [rip + main_edit_count], rax;
        jmp mim_loop;

      mim_done:
        xor rax, rax;
        pop r12;
        ret;

      mim_err:
        mov rax, 0xFFFFFFFFFFFFFF21;
        pop r12;
        ret
      }
    } @no_frame

  // ====================================================================
  // main_print_addr(addr: u64) -> u64
  //
  // Emits the text at line `addr` to fd 1, followed by a '\n'. Returns
  // 0 on success or MAIN_ERR_PARSE (0xFFFFFFFFFFFFFF21) on any sentinel
  // return from buffer_get_line_ptr / buffer_get_line_len.
  //
  // The line pointer must be stashed across the second buffer_ call
  // (which clobbers caller-save). We use main_temp_ptr in .bss.
  //
  // Register plan:
  //   rbx = saved addr (survives the two buffer_ calls and the
  //         subsequent sys_write pair via SysV callee-save)
  //   1 push (rbx) at entry -> rsp %16 == 0 at nested calls / syscalls.
  // ====================================================================
  pub let main_print_addr : (u64) -> u64 !{mem, sysreg} @{fs} =
    fn (addr: u64) -> unsafe {
      effects: {mem, sysreg},
      capabilities: {fs},
      justification: "R63.M1-005 v1.4-A: one-line printer for `p` dispatch. Two buffer_* calls (ptr + len), each sentinel-checked via `cmp rax, 512; ja` -- any BUFFER_ERR_OOB / etc. has bit 63 set. Line pointer stashed in main_temp_ptr .bss slot across the calls (avoids a stack push/pop pair; single-threaded editor, no re-entrancy hazard). Emits the line bytes then a `\\n` via two sys_write calls (fd = 1). rbx holds `addr` across all four call/syscall sites (SysV callee-save; single push at entry keeps rsp %16 == 0). Encoder discipline: no `test`; no scaled-index; direct imm32 cmp (512 fits); movabs for the MAIN_ERR_PARSE sentinel on the error return. Reserved-label prefix `mpa_`.",
      block: {
        push rbx;
        mov rbx, rdi;                       // rbx = addr

        // Fetch line pointer.
        mov rdi, rbx;
        call buffer_get_line_ptr;
        cmp rax, 512;
        ja  mpa_err;
        mov [rip + main_temp_ptr], rax;

        // Fetch line length.
        mov rdi, rbx;
        call buffer_get_line_len;
        cmp rax, 512;
        ja  mpa_err;

        // sys_write(1, ptr, len)
        mov rdi, 1;
        mov rsi, [rip + main_temp_ptr];
        mov rdx, rax;
        mov rax, 1;
        syscall;

        // sys_write(1, "\n", 1)
        mov rdi, 1;
        lea rsi, [rip + main_nl_msg];
        mov rdx, 1;
        mov rax, 1;
        syscall;

        xor rax, rax;
        pop rbx;
        ret;

      mpa_err:
        mov rax, 0xFFFFFFFFFFFFFF21;
        pop rbx;
        ret
      }
    } @no_frame

  // ====================================================================
  // _start -- REPL entry point. Never returns.
  //
  // Structure:
  //   (0) capture session_start_ns via rdtsc (unchanged from v1.1-B).
  //   (1) top of REPL: emit ':' prompt.
  //   (2) main_read_line; EOF -> jump to q handler.
  //   (3) main_parse_line; branch on main_cmd.
  //   (4) command handlers:
  //         'q' / EOF -> repl_exit_ok  (fingerprint + record + exit 0)
  //         'Q'       -> repl_exit_hard (exit 0, no emit)
  //         'w'       -> nul-terminate arg; call fileio_write_buffer
  //         'e'       -> nul-terminate arg; call fileio_read_file
  //         'p'       -> print addr1..addr2
  //         'd'       -> delete addr1..addr2
  //         'a'       -> input mode after addr1
  //         'i'       -> input mode before addr1
  //         'c'       -> delete range, then input mode before addr1
  //         0 (empty) -> if addr1 was set, move+print; else no-op
  //         other     -> repl_err ("?\n" + loop)
  //   (5) repl_err: sys_write(1, "?\n", 2); jmp repl_top.
  //   (6) repl_exit_ok / repl_exit_hard: sys_exit(0).
  //
  // @no_frame: _start ends in sys_exit and never returns to a caller;
  // no callee-save contract with the (nonexistent) caller applies.
  // Enters at rsp %16 == 0 per the PVH loader contract and does zero
  // pushes so every nested call has rsp %16 == 0 too.
  // ====================================================================
  pub let _start : () -> () !{mem, sysreg} @{fs, sched} =
    fn () -> unsafe {
      effects: {mem, sysreg},
      capabilities: {fs, sched},
      justification: "line.M1-005 v1.4-A: interactive REPL binding M1-002 grammar to M1-003 buffer + M1-004 fileio. Sequence: (0) rdtsc + shl+or reconstruction stores session_start_ns to .bss (unchanged from v1.1-B). (1) repl_top: sys_write(1, main_prompt_msg, 1) emits `:` prompt. (2) call main_read_line -> rax; MAIN_ERR_EOF (0xFFFFFFFFFFFFFF20 via movabs into r10 for compare -- imm64 needs staging) triggers repl_exit_ok (implicit `q`). (3) call main_parse_line; then load main_cmd byte and dispatch via a chain of `cmp rax, <imm8>; je repl_do_*`. (4) Command arms: `q` (0x71) -> repl_exit_ok; `Q` (0x51) -> repl_exit_hard (sys_exit(60) directly with rdi = 0); `w` (0x77) -> nul-terminate line_buf[arg_ofs+arg_len] in place then `call fileio_write_buffer(&line_buf[arg_ofs])`; `e` (0x65) same shape via `call fileio_read_file`; `p` (0x70) -> default addr1 = cursor if unset, default addr2 = addr1 if unset, loop r12..r13 calling main_print_addr, then buffer_cursor_set(r13); `d` (0x64) -> default addr1 = cursor, default addr2 = addr1, delete (addr2-addr1+1) times via buffer_delete_line(addr1) since each delete shifts subsequent lines down, increment main_edit_count per successful delete; `a` (0x61) -> default addr1 = cursor if unset, call main_input_mode(addr1); `i` (0x69) -> default addr1 = cursor if unset, call main_input_mode(addr1-1) clamping addr1 == 0 to 0; `c` (0x63) -> delete range then input-mode before original addr1; empty cmd (rax == 0) with addr1 set -> print + set cursor; empty cmd with no addr -> no-op. Every buffer_* return checked `cmp rax, 512; ja repl_err`; every fileio_* return checked `cmp rax, 0; jne repl_err`; every main_print_addr / main_input_mode return checked `cmp rax, 0; jne repl_err`. (5) repl_err: sys_write(1, main_qmark_nl_msg, 2) + jmp repl_top. (6) repl_exit_ok: buffer_last_addr for <N>; three sys_write for fingerprint (prefix + line_print_u64_dec + newline); rdtsc for session_end_ns; marshal 7-u64 LineEditRecord@0.1 into line_record_buf (lines_in=lines_out=<N>; files_read=files_written=0 at v1.4-A pending audit wire; edit_count = main_edit_count; session_start_ns = .bss slot; session_end_ns = fresh rdtsc); sys_semantic_send(0x656E694C69644500, &line_record_buf, 56) at SC+ ID 115 (return discarded); sys_exit(0). repl_exit_hard: sys_exit(0) directly (xor rdi,rdi; mov rax,60; syscall). Encoder discipline: `cmp reg, 0` everywhere; movabs for the 3 imm64 constants (0xFFFFFFFFFFFFFF20, 0xFFFFFFFFFFFFFF21, 0x656E694C69644500); every other immediate fits imm32; no `test`; no `and reg, imm64`; no `imul`; no scaled-index; byte-store `mov [r10], al` for the NUL terminator; reserved-label prefix `repl_` for dispatch labels. @no_frame; rsp %16 == 0 at every nested call site per PVH contract + zero pushes. Effects {mem, sysreg} @{fs, sched} matches v1.1-D shape; fileio_* / buffer_* / main_* helpers compose their {mem, sysreg} + @{fs} additively.",
      block: {
        // ---- (0) Capture session_start_ns via rdtsc. ----
        rdtsc;
        shl rdx, 32;
        or  rax, rdx;
        mov [rip + line_session_start_ns], rax;

        // ================================================================
        // Top of REPL loop.
        // ================================================================
      repl_top:
        // Emit the ':' prompt.
        mov rdi, 1;
        lea rsi, [rip + main_prompt_msg];
        mov rdx, 1;
        mov rax, 1;
        syscall;

        // Read one line from fd 0.
        call main_read_line;

        // EOF sentinel -> implicit `q` (soft exit with emit).
        mov r10, 0xFFFFFFFFFFFFFF20;
        cmp rax, r10;
        je  repl_exit_ok;

        // Parse into main_cmd / main_addr* / main_arg_*.
        call main_parse_line;

        // Dispatch on main_cmd.
        mov rax, [rip + main_cmd];

        cmp rax, 0x71;                      // 'q'
        je  repl_exit_ok;
        cmp rax, 0x51;                      // 'Q'
        je  repl_exit_hard;
        cmp rax, 0x77;                      // 'w'
        je  repl_do_w;
        cmp rax, 0x65;                      // 'e'
        je  repl_do_e;
        cmp rax, 0x70;                      // 'p'
        je  repl_do_p;
        cmp rax, 0x64;                      // 'd'
        je  repl_do_d;
        cmp rax, 0x61;                      // 'a'
        je  repl_do_a;
        cmp rax, 0x69;                      // 'i'
        je  repl_do_i;
        cmp rax, 0x63;                      // 'c'
        je  repl_do_c;
        cmp rax, 0;                         // empty line / bare address
        je  repl_do_empty;

        // Unknown command byte -> error and continue.
        jmp repl_err;

        // ================================================================
        // Empty command: bare address prints that line and moves cursor.
        // No address, no command: no-op (blank Enter).
        // ================================================================
      repl_do_empty:
        mov rax, [rip + main_addr1_set];
        cmp rax, 0;
        je  repl_top;
        jmp repl_print_common;

        // ================================================================
        // `p` command: print addr1..addr2 (defaults: cursor..cursor).
        // ================================================================
      repl_do_p:
        mov rax, [rip + main_addr1_set];
        cmp rax, 0;
        jne repl_do_p_have1;
        call buffer_cursor_get;
        mov [rip + main_addr1], rax;
        mov rax, 1;
        mov [rip + main_addr1_set], rax;
      repl_do_p_have1:
        jmp repl_print_common;

      repl_print_common:
        // Default addr2 = addr1 if unset.
        mov rax, [rip + main_addr2_set];
        cmp rax, 0;
        jne repl_pc_have2;
        mov rax, [rip + main_addr1];
        mov [rip + main_addr2], rax;
      repl_pc_have2:
        mov r12, [rip + main_addr1];
        mov r13, [rip + main_addr2];
        cmp r12, 0;
        je  repl_err;
        cmp r12, r13;
        ja  repl_err;
      repl_pc_loop:
        mov rdi, r12;
        call main_print_addr;
        cmp rax, 0;
        jne repl_err;
        cmp r12, r13;
        je  repl_pc_done;
        add r12, 1;
        jmp repl_pc_loop;
      repl_pc_done:
        mov rdi, r13;
        call buffer_cursor_set;
        // cursor_set may return sentinel; ignore -- cursor position is
        // best-effort here and the REPL should not "?" on a print that
        // succeeded just because dot didn't land.
        jmp repl_top;

        // ================================================================
        // `d` command: delete addr1..addr2 (defaults: cursor..cursor).
        // ================================================================
      repl_do_d:
        mov rax, [rip + main_addr1_set];
        cmp rax, 0;
        jne repl_do_d_have1;
        call buffer_cursor_get;
        mov [rip + main_addr1], rax;
        mov rax, 1;
        mov [rip + main_addr1_set], rax;
      repl_do_d_have1:
        mov rax, [rip + main_addr2_set];
        cmp rax, 0;
        jne repl_do_d_have2;
        mov rax, [rip + main_addr1];
        mov [rip + main_addr2], rax;
      repl_do_d_have2:
        mov r12, [rip + main_addr1];
        mov r13, [rip + main_addr2];
        cmp r12, 0;
        je  repl_err;
        cmp r12, r13;
        ja  repl_err;
        // count = addr2 - addr1 + 1.
        sub r13, r12;
        add r13, 1;
      repl_dd_loop:
        cmp r13, 0;
        je  repl_dd_done;
        mov rdi, r12;
        call buffer_delete_line;
        cmp rax, 512;
        ja  repl_err;
        mov rax, [rip + main_edit_count];
        add rax, 1;
        mov [rip + main_edit_count], rax;
        sub r13, 1;
        jmp repl_dd_loop;
      repl_dd_done:
        jmp repl_top;

        // ================================================================
        // `a` command: append input-mode after addr1 (default: cursor).
        // ================================================================
      repl_do_a:
        mov rax, [rip + main_addr1_set];
        cmp rax, 0;
        jne repl_do_a_have1;
        call buffer_cursor_get;
        mov [rip + main_addr1], rax;
      repl_do_a_have1:
        mov rdi, [rip + main_addr1];
        call main_input_mode;
        cmp rax, 0;
        jne repl_err;
        jmp repl_top;

        // ================================================================
        // `i` command: insert input-mode before addr1 (default: cursor).
        // Insert-before = insert-after (addr1 - 1); clamp at 0.
        // ================================================================
      repl_do_i:
        mov rax, [rip + main_addr1_set];
        cmp rax, 0;
        jne repl_do_i_have1;
        call buffer_cursor_get;
        mov [rip + main_addr1], rax;
      repl_do_i_have1:
        mov rax, [rip + main_addr1];
        cmp rax, 0;
        je  repl_do_i_zero;
        sub rax, 1;
      repl_do_i_zero:
        mov rdi, rax;
        call main_input_mode;
        cmp rax, 0;
        jne repl_err;
        jmp repl_top;

        // ================================================================
        // `c` command: change = delete range + input-mode before addr1.
        // ================================================================
      repl_do_c:
        mov rax, [rip + main_addr1_set];
        cmp rax, 0;
        jne repl_do_c_have1;
        call buffer_cursor_get;
        mov [rip + main_addr1], rax;
        mov rax, 1;
        mov [rip + main_addr1_set], rax;
      repl_do_c_have1:
        mov rax, [rip + main_addr2_set];
        cmp rax, 0;
        jne repl_do_c_have2;
        mov rax, [rip + main_addr1];
        mov [rip + main_addr2], rax;
      repl_do_c_have2:
        mov r12, [rip + main_addr1];
        mov r13, [rip + main_addr2];
        cmp r12, 0;
        je  repl_err;
        cmp r12, r13;
        ja  repl_err;
        // Save addr1 for insert phase (r12 stays through delete loop).
        // Delete count = addr2 - addr1 + 1.
        sub r13, r12;
        add r13, 1;
      repl_dc_del_loop:
        cmp r13, 0;
        je  repl_dc_ins;
        mov rdi, r12;
        call buffer_delete_line;
        cmp rax, 512;
        ja  repl_err;
        mov rax, [rip + main_edit_count];
        add rax, 1;
        mov [rip + main_edit_count], rax;
        sub r13, 1;
        jmp repl_dc_del_loop;
      repl_dc_ins:
        // Input mode before addr1 (r12): after = addr1 - 1, clamp at 0.
        mov rax, r12;
        cmp rax, 0;
        je  repl_dc_zero;
        sub rax, 1;
      repl_dc_zero:
        mov rdi, rax;
        call main_input_mode;
        cmp rax, 0;
        jne repl_err;
        jmp repl_top;

        // ================================================================
        // `w <path>` -- fileio_write_buffer with in-place NUL terminator.
        // ================================================================
      repl_do_w:
        mov rax, [rip + main_arg_len];
        cmp rax, 0;
        je  repl_err;                       // no path given
        // Compute pointer arithmetic: line_buf[arg_ofs + arg_len] = 0
        // (line_buf is 4096 bytes and main_read_line caps at 4095, so
        // this write is always within bounds).
        mov r9, [rip + main_arg_ofs];
        mov r11, [rip + main_arg_len];
        add r9, r11;                        // r9 = arg_ofs + arg_len
        lea r10, [rip + line_buf];
        add r10, r9;                        // r10 = &line_buf[end]
        xor rax, rax;
        mov [r10], al;                      // NUL terminator
        // Path pointer = &line_buf[arg_ofs].
        mov r9, [rip + main_arg_ofs];
        lea r10, [rip + line_buf];
        add r10, r9;
        mov rdi, r10;
        call fileio_write_buffer;
        cmp rax, 0;
        jne repl_err;
        jmp repl_top;

        // ================================================================
        // `e <path>` -- fileio_read_file with in-place NUL terminator.
        // ================================================================
      repl_do_e:
        mov rax, [rip + main_arg_len];
        cmp rax, 0;
        je  repl_err;
        mov r9, [rip + main_arg_ofs];
        mov r11, [rip + main_arg_len];
        add r9, r11;
        lea r10, [rip + line_buf];
        add r10, r9;
        xor rax, rax;
        mov [r10], al;
        mov r9, [rip + main_arg_ofs];
        lea r10, [rip + line_buf];
        add r10, r9;
        mov rdi, r10;
        call fileio_read_file;
        cmp rax, 0;
        jne repl_err;
        jmp repl_top;

        // ================================================================
        // Error path: "?\n" to fd 1, then loop.
        // ================================================================
      repl_err:
        mov rdi, 1;
        lea rsi, [rip + main_qmark_nl_msg];
        mov rdx, 2;
        mov rax, 1;
        syscall;
        jmp repl_top;

        // ================================================================
        // Hard quit `Q`: sys_exit(0) with no emit.
        // ================================================================
      repl_exit_hard:
        xor rdi, rdi;
        mov rax, 60;
        syscall;
        hlt;

        // ================================================================
        // Soft quit `q` or EOF: fingerprint + LineEditRecord + exit(0).
        // ================================================================
      repl_exit_ok:
        // <N> = buffer_last_addr() (final line count).
        call buffer_last_addr;
        mov r13, rax;

        // sys_write(1, "line ok -- lines=", 17).
        mov rdi, 1;
        lea rsi, [rip + line_ok_prefix_msg];
        mov rdx, 17;
        mov rax, 1;
        syscall;

        // Decimal <N> via helper (r13 survives -- SysV callee-save).
        mov rdi, r13;
        call line_print_u64_dec;

        // sys_write(1, "\n", 1).
        mov rdi, 1;
        lea rsi, [rip + main_nl_msg];
        mov rdx, 1;
        mov rax, 1;
        syscall;

        // ---- LineEditRecord@0.1 marshalling. ----
        rdtsc;
        shl rdx, 32;
        or  rax, rdx;                       // rax = session_end_ns

        lea r10, [rip + line_record_buf];
        mov [r10 + 0],  r13;                // lines_in
        mov [r10 + 8],  r13;                // lines_out
        xor r9, r9;
        mov [r10 + 16], r9;                 // files_read  (0 at v1.4-A)
        mov [r10 + 24], r9;                 // files_written (0 at v1.4-A)
        mov r9, [rip + main_edit_count];
        mov [r10 + 32], r9;                 // edit_count
        mov r9, [rip + line_session_start_ns];
        mov [r10 + 40], r9;                 // session_start_ns
        mov [r10 + 48], rax;                // session_end_ns

        // sys_semantic_send(schema, record_ptr, record_len).
        mov rdi, 0x656E694C69644500;
        lea rsi, [rip + line_record_buf];
        mov rdx, 56;
        mov rax, 115;
        syscall;
        // Return in rax discarded (see v1.1-B header § "Emit posture").

        // sys_exit(0).
        xor rdi, rdi;
        mov rax, 60;
        syscall;
        hlt
      }
    } @no_frame
}
