# line -- caps.decl
#
# Wave: R63  Milestone: M1  Landing: v1.1-B (semantic-pipe emission wire)
# Doc:  design/roadmap/post-r60-daily-use-roadmap.md §R63 in the paideia-os
#       monorepo. Category C tier-1 per design/tooling/plan.md.
#
# This file is the invariant-I6 (capability handoff visible + refusable)
# manifest the shell validates at exec: `line` receives exactly the caps
# below and no more.
#
# The three caps below are the minimum surface for the v1.1-A/B syscall
# wire to (1) read entries from a specific file path only
# (KIND_PDXFS_FILE narrowed to argv[1] -- no ambient authority on the
# rest of the filesystem), (2) write the same buffer bytes back to the
# same path (write mode on the same narrowed cap; the cap grammar
# accepts a comma-separated mode set per libpdx-cap M2-001), and (3)
# render diagnostics + the v1.1-A syscall-wire ok witness to the
# invoker's terminal (KIND_TTY narrowed to write -- no read, no
# tcsetattr).
#
# KIND_USER is NOT requested at v1.1-A/B. The v1.1-A/B body performs
# no audit-record emission and has no owner-column semantics; the user
# identity surface folds in at M1-005 when the audit shim wires up
# alongside the interactive command loop (see the parallel shape in
# umount.pdxfs/caps.decl M3 landing).
#
# KIND_IPC_ENDPOINT is NOT requested at v1.1-B despite the tool now
# emitting a semantic-pipe record. `sys_semantic_send` (SC+ ID 115,
# R107-M0-001 paideia-os #2350) takes NO cap slot -- schema is opaque
# to the kernel and the producer is capability-ungated at the R107
# landing. A future KIND_SEMANTIC_PIPE recv-side cap (arriving with
# the consumer wave) will land here without a caps.decl churn on the
# producer side; this comment is the anchor for that future edit.
#
# Cap narrowing note. Per design/tooling/plan.md §4.4 ("the tool's cap
# request narrows to exactly the argument path (never ambient
# authority)"), the KIND_PDXFS_FILE(read+write, <path>) below is a
# template. The shell's exec-time cap_manifest_verify (libpdx-cap
# M2-001) binds the concrete argument path when it hands `line` its
# narrowed cap; the template here is the shape the shell has to
# satisfy.
#
# Missing caps in the received set -> exit 4 (cap denied per I4 in
# design/tooling/plan.md §4.2). Extra caps -> the shell's
# cap_manifest_verify refuses at the shell side; `line` never sees them.
requires:
  - KIND_TTY(write)
  - KIND_PDXFS_FILE(read, <arg-path>)
  - KIND_PDXFS_FILE(write, <arg-path>)

# Declared output schemas. v1.1-B emits `LineEditRecord@0.1` (56 bytes,
# schema tag `0x656E694C69644500` -- 8-byte ASCII marker per the
# `LineEdit` mnemonic) via `sys_semantic_send` (SC+ ID 115) on the
# successful round-trip tail, carrying `{lines_in, lines_out,
# files_read, files_written, edit_count, session_start_ns,
# session_end_ns}`. Fd 1 carries the raw echoed buffer bytes plus the
# v1.1-D plain-ASCII fingerprint `line ok -- lines=<N>\n` (three
# sys_writes: prefix + line_print_u64_dec decimal + newline) -- the
# fingerprint and the semantic record are independent channels. The
# v1.1-A witness phrase `line syscall-wire ok\n` is retired by v1.1-D
# per R63.M1-006.
#
# Timestamps are raw rdtsc TSC ticks at v1.1-B (no user-facing
# `sys_clock_now` yet); schema-shape name preserved so a re-land is
# field-additive. Same honest-scope precedent as pdxsock v1.1-B and
# `src/kernel/core/fs/pdxfs_lite/write.pdx` (R25-M2-005 #919).
declares_output_schemas:
  - LineEditRecord@0.1
